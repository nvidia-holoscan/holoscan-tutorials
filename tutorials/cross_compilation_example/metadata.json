{
  "$schema": "urn:holoscan:tutorial:v1",
  "tutorial": {
    "name": "Cross Compilation Example",
    "description": "Cross-compile a minimal Holoscan C++ application for Jetson AGX Thor and IGX Thor",
    "authors": [
      {
        "name": "Zachary Crandall",
        "affiliation": "NVIDIA"
      }
    ],
    "language": "C++",
    "version": "2.1",
    "changelog": {
      "2.1": "Restore Holoscan CLI build, run, and install support",
      "2.0": "Initial update for Holoscan SDK 5.0"
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": [
        "5.0.0"
      ]
    },
    "platforms": [
      "x86_64"
    ],
    "tags": [
      "Cross Compilation",
      "Hello World",
      "IGX Thor",
      "Jetson AGX Thor"
    ],
    "ranking": 1,
    "requirements": {
    },
    "dockerfile": "tutorials/cross_compilation_example/Dockerfile",
    "default_mode": "cross_compile",
    "modes": {
      "cross_compile": {
        "description": "Build the AArch64 example in the x86_64 cross-compilation container",
        "build": {
          "docker_build_args": [
            "--platform",
            "linux/amd64"
          ],
          "cmake_options": [
            "-DCMAKE_TOOLCHAIN_FILE=/opt/holoscan-cross/aarch64-cross-sbsa.cmake"
          ]
        },
        "run": {
          "command": "bash -o pipefail -c 'file \"$1\" | grep -E \"ELF .*ARM aarch64\"' -- \"<holohub_app_bin>/cross_compilation_example\"",
          "workdir": "",
          "docker_run_args": [
            "--runtime",
            "runc",
            "--platform",
            "linux/amd64"
          ]
        }
      }
    }
  }
}
